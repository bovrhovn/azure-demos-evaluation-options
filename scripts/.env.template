# Environment configuration template for azure-demos-evaluation-options
# Copy this file to .env in the repository root and fill in your values.
# The .env file is excluded from source control.

# ─── Azure OpenAI ──────────────────────────────────────────────────────────────
# Used for evaluation judge calls and Agent Framework demos
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ─── Azure AI Foundry ──────────────────────────────────────────────────────────
# Used for Azure AI Foundry SDK demos
# Format: <HostName>;<AzureSubscriptionId>;<ResourceGroup>;<ProjectName>
AZURE_AI_PROJECT_CONNECTION_STRING=<your-connection-string>

# ─── Optional: Azure Identity ──────────────────────────────────────────────────
# If using DefaultAzureCredential (recommended for production), ensure you are
# logged in with: az login
# AZURE_CLIENT_ID=<your-managed-identity-client-id>
